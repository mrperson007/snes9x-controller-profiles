+
+// Controller profiles, controller selection and auto-configure: the Windows side.
+// The logic lives in InputProfilesCore.*; this file talks to winmm (game controllers),
+// the file system (profile files) and the Input Configuration dialog.
+
+#ifndef S9X_INPUTPROFILES_H_INCLUDED
+#define S9X_INPUTPROFILES_H_INCLUDED
+
+#include <windows.h>
+#include <tchar.h>
+#include <vector>
+#include "InputProfilesCore.h"
+
+#define NUM_PROFILE_PADS        5      // joypads 1-5 are the ones the Input dialog can configure
+#define JOYPAD_DEVICE_KEY_LEN   96     // room for any inprof::DeviceInfo::key
+
+// Which physical controller each joypad was last set up for, as inprof::DeviceInfo::key.
+// Stored in snes9x.conf (Joypad1:Device ...) so the bindings can follow the controller
+// when Windows numbers the game controllers differently from one run to the next.
+extern TCHAR JoypadDeviceKey[NUM_PROFILE_PADS][JOYPAD_DEVICE_KEY_LEN];
+
+// Game controllers that are plugged in right now.
+std::vector<inprof::DeviceInfo> InputProfiles_EnumerateDevices();
+
+// Called at startup and after "Detect Gamepad Changes": if a joypad's controller is now
+// listed under a different joystick number, moves that joypad's bindings along with it.
+void InputProfiles_ResolveDevices();
+
+// Called when the Input dialog is accepted: notes which controller each joypad uses.
+void InputProfiles_RememberDevices();
+
+// ---- Input Configuration dialog ----
+enum
+{
+	IPD_NOT_HANDLED     = 0,   // not one of ours, the dialog should deal with it
+	IPD_HANDLED         = 1,
+	IPD_BINDINGS_CHANGED= 2    // handled, and Joypad[] changed: the dialog must redraw its fields
+};
+
+// padSlot is 0..4 (joypad 1-5); turboView is true while the "Turbo" panel is displayed.
+void InputProfilesDlg_Init(HWND hDlg, int padSlot, bool turboView);
+void InputProfilesDlg_OnSlotChanged(HWND hDlg, int padSlot, bool turboView);
+int  InputProfilesDlg_OnCommand(HWND hDlg, int controlId, int notifyCode, int padSlot);
+
+#endif
diff --git a/win32/InputProfilesCore.cpp b/win32/InputProfilesCore.cpp
new file mode 100644
index 0000000..25f97f4
--- /dev/null
+++ b/win32/InputProfilesCore.cpp
@@ -0,0 +1,372 @@
+/*****************************************************************************\
+     Snes9x - Portable Super Nintendo Entertainment System (TM) emulator.
+                This file is licensed under the Snes9x License.
+   For further information, consult the LICENSE file in the root directory.
+\*****************************************************************************/
+
+// Controller profiles and auto-configure: the platform-independent part.
+// See InputProfilesCore.h.
+
+#include "InputProfilesCore.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace inprof {
+
+static const char* const kSlotNames[NUM_SLOTS] =
+{
+	"Up", "Down", "Left", "Right",
+	"A", "B", "X", "Y", "L", "R", "Start", "Select",
+	"UpLeft", "UpRight", "DownLeft", "DownRight",
+	"TurboA", "TurboB", "TurboX", "TurboY", "TurboL", "TurboR", "TurboStart", "TurboSelect",
+	"Autohold", "ClearAll", "TempTurbo", "Autofire"
+};
+
+const char* SlotName(int slot)
+{
+	return (slot >= 0 && slot < NUM_SLOTS) ? kSlotNames[slot] : "";
+}
+
+/*---------------------------------------------------------------------------*/
+// small string helpers
+
+static char LowerAscii(char c)
+{
+	return (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
+}
+
+static bool EqualNoCase(const std::string& a, const char* b)
+{
+	size_t n = strlen(b);
+	if (a.size() != n) return false;
+	for (size_t i = 0; i < n; i++)
+		if (LowerAscii(a[i]) != LowerAscii(b[i])) return false;
+	return true;
+}
+
+static bool ContainsNoCase(const std::string& hay, const char* needle)
+{
+	size_t n = strlen(needle);
+	if (n == 0) return true;
+	if (hay.size() < n) return false;
+	for (size_t i = 0; i + n <= hay.size(); i++)
+	{
+		size_t j = 0;
+		while (j < n && LowerAscii(hay[i + j]) == LowerAscii(needle[j])) j++;
+		if (j == n) return true;
+	}
+	return false;
+}
+
+static std::string Trim(const std::string& s)
+{
+	size_t b = 0, e = s.size();
+	while (b < e && (s[b] == ' ' || s[b] == '\t' || s[b] == '\r' || s[b] == '\n')) b++;
+	while (e > b && (s[e - 1] == ' ' || s[e - 1] == '\t' || s[e - 1] == '\r' || s[e - 1] == '\n')) e--;
+	return s.substr(b, e - b);
+}
+
+// values are written on one line
+static std::string OneLine(const std::string& s)
+{
+	std::string r = s;
+	for (size_t i = 0; i < r.size(); i++)
+		if (r[i] == '\r' || r[i] == '\n') r[i] = ' ';
+	return r;
+}
+
+/*---------------------------------------------------------------------------*/
+// device identity
+
+std::string DeviceBaseKey(const DeviceInfo& d)
+{
+	if (d.vendorId != 0 || d.productId != 0)
+	{
+		char buf[16];
+		sprintf(buf, "%04X:%04X", (unsigned)d.vendorId, (unsigned)d.productId);
+		return buf;
+	}
+
+	std::string name = d.name;
+	if (name.size() > (size_t)MAX_KEY_NAME_BYTES)
+	{
+		size_t len = MAX_KEY_NAME_BYTES;
+		while (len > 0 && ((unsigned char)name[len] & 0xC0) == 0x80) len--;   // do not split a UTF-8 character
+		name.erase(len);
+	}
+	return "N:" + name;
+}
+
+static std::string StripOrdinal(const std::string& key)
+{
+	size_t hash = key.rfind('#');
+	return hash == std::string::npos ? key : key.substr(0, hash);
+}
+
+void AssignDeviceKeys(std::vector<DeviceInfo>& devices)
+{
+	for (size_t i = 0; i < devices.size(); i++)
+	{
+		std::string base = DeviceBaseKey(devices[i]);
+		int ordinal = 0;
+		for (size_t j = 0; j < i; j++)
+			if (DeviceBaseKey(devices[j]) == base) ordinal++;
+
+		char buf[16];
+		sprintf(buf, "#%d", ordinal);
+		devices[i].key = base + buf;
+	}
+}
+
+int FindDeviceByKey(const std::vector<DeviceInfo>& devices, const std::string& key, bool allowSameModel)
+{
+	if (key.empty()) return -1;
+
+	for (size_t i = 0; i < devices.size(); i++)
+		if (devices[i].key == key) return (int)i;
+
+	if (!allowSameModel) return -1;
+
+	std::string base = StripOrdinal(key);
+	for (size_t i = 0; i < devices.size(); i++)
+		if (StripOrdinal(devices[i].key) == base) return (int)i;
+
+	return -1;
+}
+
+/*---------------------------------------------------------------------------*/
+// re-pointing bindings
+
+int PrimaryJoyIndex(const Bindings& b)
+{
+	int counts[MAX_JOYSTICKS] = { 0 };
+	for (int i = 0; i < NUM_SLOTS; i++)
+		if (IsJoy(b.v[i])) counts[JoyIndex(b.v[i])]++;
+
+	int best = -1, bestCount = 0;
+	for (int j = 0; j < MAX_JOYSTICKS; j++)
+		if (counts[j] > bestCount) { best = j; bestCount = counts[j]; }
+	return best;
+}
+
+int RetargetJoystick(Bindings& b, int fromJoy, int toJoy)
+{
+	if (fromJoy < 0 || fromJoy >= MAX_JOYSTICKS || toJoy < 0 || toJoy >= MAX_JOYSTICKS || fromJoy == toJoy)
+		return 0;
+
+	int changed = 0;
+	for (int i = 0; i < NUM_SLOTS; i++)
+	{
+		if (IsJoy(b.v[i]) && JoyIndex(b.v[i]) == fromJoy)
+		{
+			b.v[i] = MakeJoy(toJoy, JoyCode(b.v[i]));
+			changed++;
+		}
+	}
+	return changed;
+}
+
+/*---------------------------------------------------------------------------*/
+// auto-configure
+
+namespace
+{
+	// 0-based joystick button numbers (button n is binding code 8 + n)
+	struct ButtonMap { int B, A, Y, X, L, R, Select, Start; };
+
+	// A/B/X/Y = 0/1/2/3, LB/RB = 4/5, Back/Start = 6/7. Positionally: SNES B is the bottom
+	// face button (Xbox A), SNES A the right one (Xbox B), SNES Y the left one (Xbox X)
+	// and SNES X the top one (Xbox Y).
+	const ButtonMap kXbox        = { 0, 1, 2, 3, 4, 5, 6, 7 };
+
+	// Square/Cross/Circle/Triangle = 0/1/2/3, L1/R1 = 4/5, Share/Options = 8/9.
+	// SNES B = Cross, A = Circle, Y = Square, X = Triangle.
+	const ButtonMap kDirectInput = { 1, 2, 0, 3, 4, 5, 8, 9 };
+}
+
+Layout DetectLayout(const DeviceInfo& d)
+{
+	const unsigned vid = d.vendorId, pid = d.productId;
+
+	if (vid == 0x054C)                                   // Sony: DualShock 4, DualSense, ...
+		return LAYOUT_DIRECTINPUT;
+
+	if (vid == 0x046D && (pid == 0xC216 || pid == 0xC218 || pid == 0xC219))  // Logitech in DirectInput mode
+		return LAYOUT_DIRECTINPUT;
+
+	if (vid == 0 && (ContainsNoCase(d.name, "dualshock") || ContainsNoCase(d.name, "dualsense")))
+		return LAYOUT_DIRECTINPUT;
+
+	return LAYOUT_XBOX;
+}
+
+const char* LayoutName(Layout l)
+{
+	switch (l)
+	{
+		case LAYOUT_DIRECTINPUT: return "PlayStation / DirectInput";
+		case LAYOUT_XBOX:
+		default:                 return "Xbox";
+	}
+}
+
+bool AutoConfigure(const DeviceInfo& d, Bindings& out)
+{
+	if (d.index < 0 || d.index >= MAX_JOYSTICKS) return false;
+	if (d.numButtons < 2) return false;
+	if (!d.hasPov && d.numAxes < 2) return false;
+
+	Bindings b = out;
+	for (int i = 0; i < NUM_PAD_SLOTS; i++) b.v[i] = 0;
+
+	if (d.hasPov)
+	{
+		b.v[SLOT_UP]    = MakeJoy(d.index, JC_POV_UP);
+		b.v[SLOT_DOWN]  = MakeJoy(d.index, JC_POV_DOWN);
+		b.v[SLOT_LEFT]  = MakeJoy(d.index, JC_POV_LEFT);
+		b.v[SLOT_RIGHT] = MakeJoy(d.index, JC_POV_RIGHT);
+		// A hat reports a diagonal as one position, not as two directions, so the
+		// diagonals need bindings of their own or they would do nothing.
+		b.v[SLOT_UPLEFT]    = MakeJoy(d.index, JC_POV_UPLEFT);
+		b.v[SLOT_UPRIGHT]   = MakeJoy(d.index, JC_POV_UPRIGHT);
+		b.v[SLOT_DOWNLEFT]  = MakeJoy(d.index, JC_POV_DNLEFT);
+		b.v[SLOT_DOWNRIGHT] = MakeJoy(d.index, JC_POV_DNRIGHT);
+	}
+	else
+	{
+		// Left stick. Two axes crossing their thresholds already press two directions at
+		// once, so no diagonal bindings are needed.
+		b.v[SLOT_UP]    = MakeJoy(d.index, JC_AXIS_UP);
+		b.v[SLOT_DOWN]  = MakeJoy(d.index, JC_AXIS_DOWN);
+		b.v[SLOT_LEFT]  = MakeJoy(d.index, JC_AXIS_LEFT);
+		b.v[SLOT_RIGHT] = MakeJoy(d.index, JC_AXIS_RIGHT);
+	}
+
+	const ButtonMap& m = (DetectLayout(d) == LAYOUT_DIRECTINPUT) ? kDirectInput : kXbox;
+	const struct { int slot; int button; } assign[] =
+	{
+		{ SLOT_B, m.B }, { SLOT_A, m.A }, { SLOT_Y, m.Y }, { SLOT_X, m.X },
+		{ SLOT_L, m.L }, { SLOT_R, m.R }, { SLOT_SELECT, m.Select }, { SLOT_START, m.Start }
+	};
+	for (size_t i = 0; i < sizeof(assign) / sizeof(assign[0]); i++)
+	{
+		// never bind a button the controller does not have
+		if (assign[i].button < d.numButtons && assign[i].button < 32)
+			b.v[assign[i].slot] = MakeJoy(d.index, JC_BUTTON_BASE + assign[i].button);
+	}
+
+	out = b;
+	return true;
+}
+
+/*---------------------------------------------------------------------------*/
+// profile files
+
+std::string SerializeProfile(const Profile& p)
+{
+	std::string s;
+	s += "; Snes9x controller profile\r\n";
+	s += "Format=1\r\n";
+	s += "Name=" + OneLine(p.name) + "\r\n";
+	s += "DeviceKey=" + OneLine(p.deviceKey) + "\r\n";
+	s += "DeviceName=" + OneLine(p.deviceName) + "\r\n";
+	for (int i = 0; i < NUM_SLOTS; i++)
+	{
+		char buf[32];
+		sprintf(buf, "=0x%04X\r\n", (unsigned)p.bindings.v[i]);
+		s += kSlotNames[i];
+		s += buf;
+	}
+	return s;
+}
+
+bool ParseProfile(const std::string& textIn, Profile& out)
+{
+	std::string text = textIn;
+	if (text.size() >= 3 && (unsigned char)text[0] == 0xEF && (unsigned char)text[1] == 0xBB && (unsigned char)text[2] == 0xBF)
+		text.erase(0, 3);                                   // UTF-8 byte order mark
+
+	Profile p;
+	bool haveFormat = false;
+
+	size_t pos = 0;
+	while (pos < text.size())
+	{
+		size_t eol = text.find('\n', pos);
+		if (eol == std::string::npos) eol = text.size();
+		std::string line = Trim(text.substr(pos, eol - pos));
+		pos = eol + 1;
+
+		if (line.empty() || line[0] == ';' || line[0] == '#') continue;
+		size_t eq = line.find('=');
+		if (eq == std::string::npos) continue;
+
+		std::string key = Trim(line.substr(0, eq));
+		std::string val = Trim(line.substr(eq + 1));
+
+		if (EqualNoCase(key, "Format"))
+		{
+			if (val != "1") return false;                   // written by a newer version
+			haveFormat = true;
+		}
+		else if (EqualNoCase(key, "Name"))        p.name = val;
+		else if (EqualNoCase(key, "DeviceKey"))   p.deviceKey = val;
+		else if (EqualNoCase(key, "DeviceName"))  p.deviceName = val;
+		else
+		{
+			for (int i = 0; i < NUM_SLOTS; i++)
+			{
+				if (EqualNoCase(key, kSlotNames[i]))
+				{
+					char* end = NULL;
+					unsigned long v = strtoul(val.c_str(), &end, 0);
+					if (end != val.c_str() && *end == '\0' && v <= 0xFFFF)
+						p.bindings.v[i] = (Binding)v;
+					break;
+				}
+			}
+		}
+	}
+
+	if (!haveFormat) return false;
+	out = p;
+	return true;
+}
+
+std::string SanitizeProfileName(const std::string& in)
+{
+	std::string s;
+	for (size_t i = 0; i < in.size(); i++)
+	{
+		unsigned char c = (unsigned char)in[i];
+		if (c < 0x20 || c == 0x7F) continue;               // control characters
+		if (strchr("\\/:*?\"<>|", c) != NULL) c = '_';     // not allowed in Windows file names
+		s += (char)c;
+	}
+
+	// at most 64 bytes, without cutting a UTF-8 character in half
+	const size_t kMax = 64;
+	if (s.size() > kMax)
+	{
+		size_t len = kMax;
+		while (len > 0 && ((unsigned char)s[len] & 0xC0) == 0x80) len--;
+		s.erase(len);
+	}
+
+	s = Trim(s);
+	while (!s.empty() && (s[s.size() - 1] == '.' || s[s.size() - 1] == ' ')) s.erase(s.size() - 1);
+	if (s.empty()) return s;
+
+	// CON, NUL, COM1, ... cannot be used as file names, with or without an extension
+	std::string stem = s.substr(0, s.find('.'));
+	while (!stem.empty() && stem[stem.size() - 1] == ' ') stem.erase(stem.size() - 1);
+	bool reserved = EqualNoCase(stem, "CON") || EqualNoCase(stem, "PRN") || EqualNoCase(stem, "AUX") || EqualNoCase(stem, "NUL");
+	if (stem.size() == 4 && (EqualNoCase(stem.substr(0, 3), "COM") || EqualNoCase(stem.substr(0, 3), "LPT")) && stem[3] >= '1' && stem[3] <= '9')
+		reserved = true;
+	if (reserved) s = "_" + s;
+
+	return s;
+}
+
+} // namespace inprof
diff --git a/win32/InputProfilesCore.h b/win32/InputProfilesCore.h
new file mode 100644
index 0000000..319f0cf
--- /dev/null
+++ b/win32/InputProfilesCore.h
@@ -0,0 +1,214 @@
+/*****************************************************************************\
+     Snes9x - Portable Super Nintendo Entertainment System (TM) emulator.
+                This file is licensed under the Snes9x License.
+   For further information, consult the LICENSE file in the root directory.
+\*****************************************************************************/
+
+// Controller profiles and auto-configure: the platform-independent part.
+//
+// Nothing in here touches Windows. It works on plain data (a "Bindings" array and
+// a description of a game controller), so it can be unit tested anywhere
+// (see win32/tests/inputprofiles_core_test.cpp). The Windows side
+// (InputProfiles.cpp) feeds it real devices and real SJoypad structs.
+
+#ifndef S9X_INPUTPROFILES_CORE_H_INCLUDED
+#define S9X_INPUTPROFILES_CORE_H_INCLUDED
+
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+namespace inprof {
+
+typedef uint16_t Binding;
+
+/*---------------------------------------------------------------------------*\
+  Binding encoding. This mirrors S9xGetState() in win32.cpp:
+    keyboard:  a Windows virtual-key code (< 0x100), 0 = unbound
+    joystick:  0x8000 | (joystick id << 8) | code
+\*---------------------------------------------------------------------------*/
+enum
+{
+	JOY_FLAG        = 0x8000,
+
+	JC_AXIS_LEFT    = 0,    // X axis negative
+	JC_AXIS_RIGHT   = 1,
+	JC_AXIS_UP      = 2,    // Y axis negative
+	JC_AXIS_DOWN    = 3,
+	JC_POV_LEFT     = 4,
+	JC_POV_RIGHT    = 5,
+	JC_POV_UP       = 6,
+	JC_POV_DOWN     = 7,
+	JC_BUTTON_BASE  = 8,    // button n (0-based) is code 8 + n, n = 0..31
+	JC_POV_DNLEFT   = 49,
+	JC_POV_DNRIGHT  = 50,
+	JC_POV_UPLEFT   = 51,
+	JC_POV_UPRIGHT  = 52,
+
+	MAX_JOYSTICKS   = 16
+};
+
+inline bool    IsJoy(Binding b)               { return (b & JOY_FLAG) != 0; }
+inline int     JoyIndex(Binding b)            { return (b >> 8) & 0x0F; }
+inline int     JoyCode(Binding b)             { return b & 0xFF; }
+inline Binding MakeJoy(int joy, int code)     { return (Binding)(JOY_FLAG | ((joy & 0x0F) << 8) | (code & 0xFF)); }
+
+/*---------------------------------------------------------------------------*\
+  All bindings that belong to one player slot: the 16 pad inputs followed by the
+  12 inputs of that slot's "Turbo" panel.
+\*---------------------------------------------------------------------------*/
+enum Slot
+{
+	SLOT_UP, SLOT_DOWN, SLOT_LEFT, SLOT_RIGHT,
+	SLOT_A, SLOT_B, SLOT_X, SLOT_Y, SLOT_L, SLOT_R, SLOT_START, SLOT_SELECT,
+	SLOT_UPLEFT, SLOT_UPRIGHT, SLOT_DOWNLEFT, SLOT_DOWNRIGHT,
+	NUM_PAD_SLOTS,                                   // 16
+
+	SLOT_TURBO_A = NUM_PAD_SLOTS, SLOT_TURBO_B, SLOT_TURBO_X, SLOT_TURBO_Y,
+	SLOT_TURBO_L, SLOT_TURBO_R, SLOT_TURBO_START, SLOT_TURBO_SELECT,
+	SLOT_AUTOHOLD, SLOT_CLEARALL, SLOT_TEMPTURBO, SLOT_AUTOFIRE,
+	NUM_SLOTS                                        // 28
+};
+
+const char* SlotName(int slot);   // the key used in profile files ("Up", "TurboA", ...)
+
+struct Bindings
+{
+	Binding v[NUM_SLOTS];
+	Bindings() { for (int i = 0; i < NUM_SLOTS; i++) v[i] = 0; }
+};
+
+/*---------------------------------------------------------------------------*\
+  Generic copy between Bindings and Snes9x's SJoypad pair (main pad + turbo panel).
+  A template so this header does not need wsnes9x.h; it works with any struct that
+  has SJoypad's field names (the unions Left/Autohold, Right/ClearAll, Up/TempTurbo
+  and Down/Autofire share storage in the real struct, which is exactly how the
+  turbo panel is stored).
+\*---------------------------------------------------------------------------*/
+template <class PadT>
+void ReadBindings(const PadT& pad, const PadT& turbo, Bindings& out)
+{
+	out.v[SLOT_UP] = pad.Up;           out.v[SLOT_DOWN] = pad.Down;
+	out.v[SLOT_LEFT] = pad.Left;       out.v[SLOT_RIGHT] = pad.Right;
+	out.v[SLOT_A] = pad.A;             out.v[SLOT_B] = pad.B;
+	out.v[SLOT_X] = pad.X;             out.v[SLOT_Y] = pad.Y;
+	out.v[SLOT_L] = pad.L;             out.v[SLOT_R] = pad.R;
+	out.v[SLOT_START] = pad.Start;     out.v[SLOT_SELECT] = pad.Select;
+	out.v[SLOT_UPLEFT] = pad.Left_Up;  out.v[SLOT_UPRIGHT] = pad.Right_Up;
+	out.v[SLOT_DOWNLEFT] = pad.Left_Down; out.v[SLOT_DOWNRIGHT] = pad.Right_Down;
+
+	out.v[SLOT_TURBO_A] = turbo.A;     out.v[SLOT_TURBO_B] = turbo.B;
+	out.v[SLOT_TURBO_X] = turbo.X;     out.v[SLOT_TURBO_Y] = turbo.Y;
+	out.v[SLOT_TURBO_L] = turbo.L;     out.v[SLOT_TURBO_R] = turbo.R;
+	out.v[SLOT_TURBO_START] = turbo.Start; out.v[SLOT_TURBO_SELECT] = turbo.Select;
+	out.v[SLOT_AUTOHOLD] = turbo.Autohold;   out.v[SLOT_CLEARALL] = turbo.ClearAll;
+	out.v[SLOT_TEMPTURBO] = turbo.TempTurbo; out.v[SLOT_AUTOFIRE] = turbo.Autofire;
+}
+
+template <class PadT>
+void WriteBindings(const Bindings& in, PadT& pad, PadT& turbo)
+{
+	pad.Up = in.v[SLOT_UP];            pad.Down = in.v[SLOT_DOWN];
+	pad.Left = in.v[SLOT_LEFT];        pad.Right = in.v[SLOT_RIGHT];
+	pad.A = in.v[SLOT_A];              pad.B = in.v[SLOT_B];
+	pad.X = in.v[SLOT_X];              pad.Y = in.v[SLOT_Y];
+	pad.L = in.v[SLOT_L];              pad.R = in.v[SLOT_R];
+	pad.Start = in.v[SLOT_START];      pad.Select = in.v[SLOT_SELECT];
+	pad.Left_Up = in.v[SLOT_UPLEFT];   pad.Right_Up = in.v[SLOT_UPRIGHT];
+	pad.Left_Down = in.v[SLOT_DOWNLEFT]; pad.Right_Down = in.v[SLOT_DOWNRIGHT];
+
+	turbo.A = in.v[SLOT_TURBO_A];      turbo.B = in.v[SLOT_TURBO_B];
+	turbo.X = in.v[SLOT_TURBO_X];      turbo.Y = in.v[SLOT_TURBO_Y];
+	turbo.L = in.v[SLOT_TURBO_L];      turbo.R = in.v[SLOT_TURBO_R];
+	turbo.Start = in.v[SLOT_TURBO_START]; turbo.Select = in.v[SLOT_TURBO_SELECT];
+	turbo.Autohold = in.v[SLOT_AUTOHOLD];   turbo.ClearAll = in.v[SLOT_CLEARALL];
+	turbo.TempTurbo = in.v[SLOT_TEMPTURBO]; turbo.Autofire = in.v[SLOT_AUTOFIRE];
+}
+
+/*---------------------------------------------------------------------------*\
+  Game controllers
+\*---------------------------------------------------------------------------*/
+struct DeviceInfo
+{
+	int         index;        // Windows joystick id (0..15): what bindings refer to
+	std::string name;         // display name, UTF-8
+	uint16_t    vendorId;
+	uint16_t    productId;
+	int         numButtons;
+	int         numAxes;
+	bool        hasPov;       // has a d-pad / hat
+	std::string key;          // stable identity, see AssignDeviceKeys()
+
+	DeviceInfo() : index(0), vendorId(0), productId(0), numButtons(0), numAxes(0), hasPov(false) {}
+};
+
+// "045E:028E" when the vendor/product ids are known, otherwise "N:<name>" (the name cut
+// to MAX_KEY_NAME_BYTES so a key always fits the fixed-size field in snes9x.conf).
+const int MAX_KEY_NAME_BYTES = 64;
+std::string DeviceBaseKey(const DeviceInfo& d);
+
+// Sets .key of every device to "<base>#<n>", n counting devices with the same base
+// key in list order. Two identical controllers therefore get #0 and #1.
+void AssignDeviceKeys(std::vector<DeviceInfo>& devices);
+
+// Position in 'devices' (not the Windows id) of the device with this key, or -1.
+// With allowSameModel, a key that is not connected (say "...#1" when only one such
+// controller is plugged in) falls back to the first device with the same base key.
+// That is right for suggesting a controller for a profile, but not for silently
+// re-pointing a player: two players must never end up on one physical controller.
+int FindDeviceByKey(const std::vector<DeviceInfo>& devices, const std::string& key, bool allowSameModel = true);
+
+/*---------------------------------------------------------------------------*\
+  Re-pointing bindings at another physical controller
+\*---------------------------------------------------------------------------*/
+
+// The joystick id used by most of the joystick bindings (lowest id on a tie), or -1
+// if every binding is a keyboard key / unbound.
+int PrimaryJoyIndex(const Bindings& b);
+
+// Changes every joystick binding that refers to joystick 'fromJoy' so it refers to
+// 'toJoy' instead. Button/axis/hat codes are untouched. Returns how many changed.
+int RetargetJoystick(Bindings& b, int fromJoy, int toJoy);
+
+/*---------------------------------------------------------------------------*\
+  Auto-configure
+\*---------------------------------------------------------------------------*/
+enum Layout
+{
+	LAYOUT_XBOX,          // A/B/X/Y = buttons 0-3, Back/Start = 6/7 (XInput order; also the fallback)
+	LAYOUT_DIRECTINPUT    // Square/Cross/Circle/Triangle = 0-3, Share/Options = 8/9 (DualShock 4, DualSense, Logitech DInput)
+};
+
+Layout      DetectLayout(const DeviceInfo& d);
+const char* LayoutName(Layout l);
+
+// Fills the 16 pad slots of 'out' for this controller, "same physical position" style:
+// the SNES B button goes on the bottom face button, A on the right, Y on the left,
+// X on the top, plus shoulders, Select and Start. D-pad is used for directions when
+// the controller has one (including its diagonals), else the left stick.
+// The turbo slots of 'out' are left alone. Returns false (and leaves 'out' alone) if
+// the device does not look like a usable gamepad.
+bool AutoConfigure(const DeviceInfo& d, Bindings& out);
+
+/*---------------------------------------------------------------------------*\
+  Profiles: a named set of bindings plus the controller they were made for.
+\*---------------------------------------------------------------------------*/
+struct Profile
+{
+	std::string name;
+	std::string deviceKey;    // DeviceInfo::key of the controller it was saved from ("" = keyboard only)
+	std::string deviceName;   // for display only
+	Bindings    bindings;
+};
+
+std::string SerializeProfile(const Profile& p);
+bool        ParseProfile(const std::string& text, Profile& out);
+
+// Turns what the user typed into something safe to use as a file name (no path
+// separators or other characters Windows forbids, no reserved device names, no
+// trailing dots/spaces, at most 64 bytes). Returns "" if nothing usable is left.
+std::string SanitizeProfileName(const std::string& in);
+
+} // namespace inprof
+
+#endif
